{
  "name": "@paperfill/xlsx",
  "version": "0.2.0",
  "description": "Excel (.xlsx) adapter and preview layout for paperfill",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/style.css dist/style.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paperfill/kernel": "0.2.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
