{
  "name": "@paperfill/kernel",
  "version": "0.2.0",
  "description": "Headless contract template kernel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
