  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@paperfill/kernel": "0.3.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vue": "^3.5.13"
  }
}
