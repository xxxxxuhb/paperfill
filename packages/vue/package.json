{
  "name": "@paperfill/vue",
  "version": "0.3.1",
  "description": "Vue 3 helpers for paperfill",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
