{
  "name": "@paperfill/ui",
  "version": "0.3.0",
  "description": "Framework-free field controls for paperfill (native input/select/textarea/date)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/style.css','dist/style.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paperfill/kernel": "0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
