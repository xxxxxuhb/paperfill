{
  "name": "paperfill",
  "version": "0.2.0",
  "description": "在 Word / Excel 原文排版上填写合同。Headless contract template runtime for docx/xlsx.",
  "keywords": [
    "contract",
    "docx",
    "xlsx",
    "word",
    "excel",
    "template",
    "fill",
    "paperfill"
  ],
  "license": "MIT",
  "homepage": "https://github.com/xxxxxuhb/paperfill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxxxxuhb/paperfill.git"
  },
  "bugs": {
    "url": "https://github.com/xxxxxuhb/paperfill/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "require": "./dist/docx.js",
      "default": "./dist/docx.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "require": "./dist/xlsx.js",
      "default": "./dist/xlsx.js"
    },
    "./xlsx/style.css": "./dist/xlsx-style.css",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "require": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./ui/style.css": "./dist/style.css",
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "require": "./dist/pdf.js",
      "default": "./dist/pdf.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "require": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "require": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../ui/dist/style.css dist/style.css && cp ../xlsx/dist/style.css dist/xlsx-style.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paperfill/docx": "0.2.0",
    "@paperfill/kernel": "0.2.0",
    "@paperfill/pdf": "0.2.0",
    "@paperfill/react": "0.2.0",
    "@paperfill/ui": "0.2.0",
    "@paperfill/vue": "0.2.0",
    "@paperfill/xlsx": "0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
